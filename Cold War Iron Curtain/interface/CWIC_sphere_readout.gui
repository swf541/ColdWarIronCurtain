guiTypes = {
	# Sphere-influence readout — compact, drawn INSIDE the empty right half of the
	# existing "Sphere of Influences" box (CWIC_sphere_container: x=15 y=386, 245x85).
	# No background: it inherits the sphere box's frame.
	containerWindowType = {
		name = "CWIC_sphere_readout"
		position = { x = 110 y = 412 }
		size = { width = 150 height = 54 }
		clipping = no
		moveable = no

		instantTextBoxType = {
			name = "sph_readout_score"
			position = { x = 0 y = 0 }
			font = "hoi_16mbs"
			text = "Influence: [?sph_disp_score|0]/100"
			maxWidth = 150
			maxHeight = 16
			format = left
			fixedsize = yes
			pdx_tooltip = "sph_readout_TT"
		}
		instantTextBoxType = {
			name = "sph_readout_stage"
			position = { x = 0 y = 17 }
			font = "hoi_16mbs"
			text = "Accords: [GetSphStageName]"
			maxWidth = 150
			maxHeight = 16
			format = left
			fixedsize = yes
			pdx_tooltip = "sph_readout_TT"
		}
		instantTextBoxType = {
			name = "sph_readout_status"
			position = { x = 0 y = 34 }
			font = "hoi_16mbs"
			text = "[GetSphInfluenceStatus] [?ROOT.sph_active_ids^num|0]/[?ROOT.sph_slots|0]"
			maxWidth = 150
			maxHeight = 16
			format = left
			fixedsize = yes
			pdx_tooltip = "sph_readout_TT"
		}
	}
}
